DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0

# Hosted commands force config.production. Local manage.py retains SQLite
# unless DATABASE_URL is explicitly supplied. This file is not auto-loaded.
DJANGO_SETTINGS_MODULE=config.production
DATABASE_URL=postgresql://app_user:REPLACE_URL_ENCODED_PASSWORD@db.example.com:5432/rytivo
DATABASE_SSLMODE=verify-full
# Set the provider's CA file path, or 'system' when supported by its libpq.
DATABASE_SSLROOTCERT=/run/secrets/database-ca.pem
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
DATABASE_TRANSACTION_POOLING=false
DJANGO_CONN_MAX_AGE=60
REDIS_URL=rediss://:REPLACE_URL_ENCODED_PASSWORD@cache.example.com:6379/0
CACHE_KEY_PREFIX=rytivo-beta
DJANGO_MEDIA_ROOT=/var/lib/rytivo/media
# Only true behind a trusted ingress that strips client-supplied headers.
DJANGO_TRUST_PROXY_HTTPS=false
PORT=8000
WEB_CONCURRENCY=2
# CHANGED (perf): new variable, added alongside the gunicorn.conf.py switch
# from 'sync' to 'gthread' workers. Threads-per-worker; each active thread
# touching the database opens its own connection, so raise this only
# together with the hosting provider's connection budget. See
# gunicorn.conf.py and HOSTED_CONFIGURATION.md for the reasoning.
WEB_THREADS=4

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com

# Configure only after in-app disclosure/permission and provider account setup.
MODERATION_ENABLED=true
MODERATION_API_KEY=
MODERATION_DISCLOSURE_CONFIRMED=false
MODERATION_CONTACT_EMAIL=support@rytivo.app
MODERATION_CONSENT_VERSION=2026-09-15
# Seconds a worker may be held waiting for the classifier. Size with
# WEB_CONCURRENCY: a submission holds one synchronous worker for this long.
MODERATION_TIMEOUT_SECONDS=8
