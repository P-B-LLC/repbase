      "readOnly": true
     },
     "exercise_count": {
      "type": "integer",
      "readOnly": true
     },
     "renamed": {
      "type": "boolean",
      "readOnly": true
     },
     "already_saved": {
      "type": "boolean",
      "readOnly": true,
      "default": false
     }
    },
    "required": [
