      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,6}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "carbohydrate_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,6}(?:\\.\\d{0,2})?$",
