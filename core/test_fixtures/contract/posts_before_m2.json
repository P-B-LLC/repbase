{
 "note": "The Post contract as it stood before Milestone 2 (repbase 51d34c6): every component reachable from the post cards, the save results and the two post request bodies. Frozen. The apps in people's hands were generated from this, so responses must keep validating against it.",
 "components": {
  "schemas": {
   "ContentTypeEnum": {
    "enum": [
     "image/heic",
     "image/jpeg",
     "image/png",
     "image/webp"
    ],
    "type": "string",
    "description": "* `image/heic` - image/heic\n* `image/jpeg` - image/jpeg\n* `image/png` - image/png\n* `image/webp` - image/webp"
   },
   "CreatePostKindEnum": {
    "enum": [
     "workout",
     "meal",
     "planner",
     "media"
    ],
    "type": "string",
    "description": "* `workout` - Workout\n* `meal` - Meal\n* `planner` - Planner\n* `media` - Photo or video"
   },
   "CreatePostRequest": {
    "type": "object",
    "description": "What to post, and who may see it.\n\nA reference and nothing else. The server reads the source itself and builds\nthe snapshot from it, so no client can decide what a post says it did \u2014\naccepting the content here would be accepting a five-hundred-kilogram squat\nfrom anyone who could type one.\n\nA `media` post references nothing: it is a photo or a clip and a caption,\nand since it carries no snapshot it makes no claim to check.",
    "properties": {
     "kind": {
      "$ref": "#/components/schemas/CreatePostKindEnum"
     },
     "source_id": {
      "type": "integer",
      "minimum": 1,
      "description": "The workout session, meal or planner entry to post. Required for those kinds; leave it out of a media post."
     },
     "caption": {
      "type": "string",
      "default": "",
      "maxLength": 300
     },
     "shows_weights": {
      "type": "boolean",
      "default": true
     },
     "visibility": {
      "allOf": [
       {
        "$ref": "#/components/schemas/VisibilityEnum"
       }
      ],
      "default": "public"
     },
     "content_type": {
      "$ref": "#/components/schemas/ContentTypeEnum"
     },
     "image_base64": {
      "type": "string",
      "description": "The image bytes, base64 encoded, without a data: prefix."
     },
     "cooking_instructions": {
      "type": "string",
      "description": "How the meal was made, for a meal post. Ignored for other kinds.",
      "maxLength": 4000
     },
     "expects_video": {
      "type": "boolean",
      "default": false,
      "description": "True when a clip will be uploaded to this post next. Required for a media post without a photo, which stays visible only to its author until the clip is ready to watch."
     }
    },
    "required": [
     "kind"
    ]
   },
   "ForYouPage": {
    "type": "object",
    "description": "One page of the For You feed, in the shape every cursor page has.",
    "properties": {
     "next": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "previous": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "results": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ForYouPost"
      },
      "readOnly": true
     }
    },
    "required": [
     "next",
     "previous",
     "results"
    ]
   },
   "ForYouPost": {
    "type": "object",
    "description": "A post on the For You page: the ordinary card, plus why it is there.",
    "properties": {
     "id": {
      "type": "integer",
      "readOnly": true
     },
     "author": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PublicRepbaseUser"
       }
      ],
      "readOnly": true
     },
     "kind": {
      "type": "string",
      "readOnly": true
     },
     "image_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "feed_image_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "video": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostVideo"
       }
      ],
      "nullable": true,
      "readOnly": true
     },
     "caption": {
      "type": "string",
      "readOnly": true
     },
     "visibility": {
      "type": "string",
      "readOnly": true
     },
     "workout": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostWorkout"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "meal": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostMeal"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "planner": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostPlannerEntry"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "source_id": {
      "type": "integer",
      "nullable": true,
      "readOnly": true
     },
     "viewer_follows_author": {
      "type": "boolean",
      "readOnly": true
     },
     "shows_weights": {
      "type": "boolean",
      "readOnly": true
     },
     "viewer_is_author": {
      "type": "boolean",
      "readOnly": true
     },
     "like_count": {
      "type": "integer",
      "readOnly": true
     },
     "comment_count": {
      "type": "integer",
      "readOnly": true
     },
     "repost_count": {
      "type": "integer",
      "readOnly": true
     },
     "viewer_has_liked": {
      "type": "boolean",
      "readOnly": true
     },
     "viewer_has_reposted": {
      "type": "boolean",
      "readOnly": true
     },
     "viewer_saved": {
      "type": "boolean",
      "readOnly": true
     },
     "repost_of": {
      "allOf": [
       {
        "$ref": "#/components/schemas/RepostedPost"
       }
      ],
      "nullable": true,
      "readOnly": true
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
     },
     "published_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
     },
     "moderation_status": {
      "type": "string",
      "readOnly": true
     },
     "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
     },
     "recommendation": {
      "allOf": [
       {
        "$ref": "#/components/schemas/Recommendation"
       }
      ],
      "readOnly": true
     }
    },
    "required": [
     "author",
     "caption",
     "comment_count",
     "created_at",
     "feed_image_url",
     "id",
     "image_url",
     "kind",
     "like_count",
     "meal",
     "moderation_status",
     "planner",
     "published_at",
     "recommendation",
     "repost_count",
     "repost_of",
     "shows_weights",
     "source_id",
     "updated_at",
     "video",
     "viewer_follows_author",
     "viewer_has_liked",
     "viewer_has_reposted",
     "viewer_is_author",
     "viewer_saved",
     "visibility",
     "workout"
    ]
   },
   "PaginatedPostList": {
    "type": "object",
    "required": [
     "results"
    ],
    "properties": {
     "next": {
      "type": "string",
      "nullable": true,
      "format": "uri",
      "example": "http://api.example.org/accounts/?cursor=cD00ODY%3D\""
     },
     "previous": {
      "type": "string",
      "nullable": true,
      "format": "uri",
      "example": "http://api.example.org/accounts/?cursor=cj0xJnA9NDg3"
     },
     "results": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Post"
      }
     }
    }
   },
   "PatchedUpdatePostRequest": {
    "type": "object",
    "description": "The two things about a post that can still change.\n\nThe snapshot is not among them. It is the record of what happened, and one\nthat could be edited into a different workout after people had read it would\nbe worth nothing as a record.",
    "properties": {
     "caption": {
      "type": "string",
      "maxLength": 300
     },
     "visibility": {
      "$ref": "#/components/schemas/VisibilityEnum"
     }
    }
   },
   "PlatformEnum": {
    "enum": [
     "instagram",
     "snapchat",
     "tiktok",
     "youtube",
     "x",
     "website"
    ],
    "type": "string",
    "description": "* `instagram` - Instagram\n* `snapchat` - Snapchat\n* `tiktok` - TikTok\n* `youtube` - YouTube\n* `x` - X\n* `website` - Website"
   },
   "Post": {
    "type": "object",
    "description": "A post as anyone allowed to see it reads it.\n\n`workout`, `meal` and `planner` are three keys side by side with exactly one\nof them filled in, rather than one field whose type is chosen by `kind`. A\nclient built before a fourth kind existed then fails to draw that one post;\nwith a discriminated union it fails to decode the whole page around it.\n\n`kind` and `visibility` go out as plain strings for the same reason: a value\nadded later should be a string the client does not recognise, not a decoding\nerror. Requests still take a closed set \u2014 see `CreatePostSerializer`.\n\nEvery field here is read-only. A post is created from a source it does not\ncarry and edited through `UpdatePostSerializer`, so there is no shape in\nwhich this serializer accepts anything.",
    "properties": {
     "id": {
      "type": "integer",
      "readOnly": true
     },
     "author": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PublicRepbaseUser"
       }
      ],
      "readOnly": true
     },
     "kind": {
      "type": "string",
      "readOnly": true
     },
     "image_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "feed_image_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "video": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostVideo"
       }
      ],
      "nullable": true,
      "readOnly": true
     },
     "caption": {
      "type": "string",
      "readOnly": true
     },
     "visibility": {
      "type": "string",
      "readOnly": true
     },
     "workout": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostWorkout"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "meal": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostMeal"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "planner": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostPlannerEntry"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "source_id": {
      "type": "integer",
      "nullable": true,
      "readOnly": true
     },
     "viewer_follows_author": {
      "type": "boolean",
      "readOnly": true
     },
     "shows_weights": {
      "type": "boolean",
      "readOnly": true
     },
     "viewer_is_author": {
      "type": "boolean",
      "readOnly": true
     },
     "like_count": {
      "type": "integer",
      "readOnly": true
     },
     "comment_count": {
      "type": "integer",
      "readOnly": true
     },
     "repost_count": {
      "type": "integer",
      "readOnly": true
     },
     "viewer_has_liked": {
      "type": "boolean",
      "readOnly": true
     },
     "viewer_has_reposted": {
      "type": "boolean",
      "readOnly": true
     },
     "viewer_saved": {
      "type": "boolean",
      "readOnly": true
     },
     "repost_of": {
      "allOf": [
       {
        "$ref": "#/components/schemas/RepostedPost"
       }
      ],
      "nullable": true,
      "readOnly": true
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
     },
     "published_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
     },
     "moderation_status": {
      "type": "string",
      "readOnly": true
     },
     "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
     }
    },
    "required": [
     "author",
     "caption",
     "comment_count",
     "created_at",
     "feed_image_url",
     "id",
     "image_url",
     "kind",
     "like_count",
     "meal",
     "moderation_status",
     "planner",
     "published_at",
     "repost_count",
     "repost_of",
     "shows_weights",
     "source_id",
     "updated_at",
     "video",
     "viewer_follows_author",
     "viewer_has_liked",
     "viewer_has_reposted",
     "viewer_is_author",
     "viewer_saved",
     "visibility",
     "workout"
    ]
   },
   "PostMeal": {
    "type": "object",
    "description": "A posted meal, frozen at the moment it was posted.\n\nTotals are derived from the foods nested underneath, exactly as\n`FoodMealSerializer` derives them from a live meal, and rendered through the\nsame `NUTRITION_DECIMAL` so a frozen calorie count has the same shape on the\nwire as a live one.",
    "properties": {
     "name": {
      "type": "string",
      "readOnly": true
     },
     "date": {
      "type": "string",
      "format": "date",
      "readOnly": true
     },
     "entries": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PostMealEntry"
      },
      "readOnly": true
     },
     "cooking_instructions": {
      "type": "string",
      "readOnly": true
     },
     "total_calories": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_protein_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_carbohydrate_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_fat_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     }
    },
    "required": [
     "cooking_instructions",
     "date",
     "entries",
     "name",
     "total_calories",
     "total_carbohydrate_grams",
     "total_fat_grams",
     "total_protein_grams"
    ]
   },
