     "username",
     "viewer_follows",
     "viewer_has_requested",
     "weight_kg"
    ]
   },
   "Recommendation": {
    "type": "object",
    "description": "Why the For You page put a post where it did.\n\n`reason` is a short code -- following, interest, similar, discovery,\nnew_creator, popular or fresh -- sent as a plain string so a reason added\nlater is a value the client does not recognise rather than a decoding\nerror. `label` is a sentence fit to show under the post as it is.",
    "properties": {
     "reason": {
      "type": "string",
      "readOnly": true
     },
     "label": {
      "type": "string",
      "readOnly": true
     }
    },
    "required": [
     "label",
     "reason"
    ]
   },
   "RepostedPost": {
    "type": "object",
    "description": "The original, as it appears inside a repost.\n\nDeliberately not `PostSerializer`. That one carries `repost_of`, and a\nserializer that contains itself is a schema no generator can express and a\ndepth no reader wants. A repost cannot be reposted, so one level is all\nthere is to show.",
    "properties": {
     "id": {
      "type": "integer",
      "readOnly": true
     },
     "author": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PublicRepbaseUser"
       }
      ],
      "readOnly": true
     },
     "kind": {
      "type": "string",
      "readOnly": true
     },
     "image_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "feed_image_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "video": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostVideo"
       }
      ],
      "nullable": true,
      "readOnly": true
     },
     "caption": {
      "type": "string",
      "readOnly": true
     },
     "workout": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostWorkout"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "meal": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostMeal"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "planner": {
      "allOf": [
       {
        "$ref": "#/components/schemas/PostPlannerEntry"
       }
      ],
      "readOnly": true,
      "nullable": true
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
     },
     "published_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "nullable": true
     }
    },
    "required": [
     "author",
     "caption",
     "created_at",
     "feed_image_url",
     "id",
     "image_url",
     "kind",
     "meal",
     "planner",
     "published_at",
     "video",
     "workout"
    ]
   },
   "SavedMealResult": {
    "type": "object",
    "description": "What saving somebody else's posted meal produced.\n\nThe same shape as `SavedWorkoutResultSerializer` and for the same reason:\nsaved meal names are unique per user, so the name it landed under is not\nalways the one on the post and the app has to be able to say so.",
