     },
     "fat_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,6}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_calories": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_protein_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_carbohydrate_grams": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
      "readOnly": true
     },
     "total_fat_grams": {
