   "PostVideo": {
    "type": "object",
    "description": "A post's clip, as its reader may see it.\n\n`status` and `content_type` go out as plain strings, as `kind` does on a\npost. A choice field would add a `status` enum to the contract, and\ndrf-spectacular resolves two enums of the same field name by renaming\nboth -- so the session status enum the generated clients already use\nwould change its name because of a field on a different object.",
    "properties": {
     "url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "content_type": {
      "type": "string",
      "readOnly": true
     },
     "duration_ms": {
      "type": "integer",
      "readOnly": true
     },
     "width": {
      "type": "integer",
      "readOnly": true
     },
     "height": {
      "type": "integer",
      "readOnly": true
     },
     "has_audio": {
      "type": "boolean",
      "readOnly": true
     },
     "status": {
      "type": "string",
      "readOnly": true
     },
     "processing_state": {
      "type": "string",
      "readOnly": true
     },
     "processing_error": {
      "type": "string",
      "readOnly": true
     },
     "thumbnail_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "variants": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/VideoVariant"
      },
      "readOnly": true
     }
    },
    "required": [
     "content_type",
     "duration_ms",
     "has_audio",
     "height",
     "processing_error",
     "processing_state",
     "status",
     "thumbnail_url",
     "url",
     "variants",
     "width"
    ]
   },
   "PostWorkout": {
    "type": "object",
    "description": "A posted workout, frozen at the moment it was posted.\n\nThe three totals are summed from the exercises nested underneath rather\nthan stored, the way `FoodMealSerializer` sums a meal's foods, so a figure\nprinted under a card cannot disagree with the rows printed inside it. They\nwalk `exercises` and nothing else, so a page of them costs no queries as\nlong as the feed prefetches that relation.\n\nThere is no `id` here or on the other two snapshots: each is one-to-one with\nits post, the post's id already identifies it, and an id in this position\ninvites a client into thinking it can fetch the workout it came from.",
    "properties": {
     "title": {
      "type": "string",
      "readOnly": true
     },
     "workout_type": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "activity": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "performed_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
     },
     "duration_seconds": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
     },
     "cardio_machine": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "cardio_seconds": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
     },
     "cardio_distance_km": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,4}(?:\\.\\d{0,3})?$",
      "readOnly": true,
      "nullable": true
     },
     "route_distance_km": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,4}(?:\\.\\d{0,3})?$",
      "readOnly": true,
      "nullable": true
     },
     "pace_seconds_per_km": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
     },
     "elevation_gain_m": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,6}(?:\\.\\d{0,1})?$",
      "readOnly": true,
      "nullable": true
     },
     "exercises": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PostWorkoutExercise"
      },
      "readOnly": true
     },
     "exercise_count": {
      "type": "integer",
      "readOnly": true
     },
     "total_set_count": {
      "type": "integer",
      "readOnly": true
     },
     "total_volume_kg": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
      "nullable": true,
      "readOnly": true
     }
    },
    "required": [
     "cardio_distance_km",
     "cardio_machine",
     "cardio_seconds",
     "duration_seconds",
     "elevation_gain_m",
     "exercise_count",
     "exercises",
     "pace_seconds_per_km",
     "performed_at",
     "route_distance_km",
     "title",
     "total_set_count",
     "total_volume_kg",
     "workout_type"
    ]
   },
   "PostWorkoutExercise": {
    "type": "object",
    "description": "One exercise inside a posted workout.",
    "properties": {
     "id": {
      "type": "integer",
      "readOnly": true
     },
     "name": {
      "type": "string",
      "readOnly": true
     },
     "order": {
      "type": "integer",
      "readOnly": true
     },
     "set_count": {
      "type": "integer",
      "readOnly": true
     },
     "top_set_weight_kg": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,5}(?:\\.\\d{0,2})?$",
      "readOnly": true,
      "nullable": true
     },
     "top_set_reps": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
     },
     "total_reps": {
      "type": "integer",
      "readOnly": true,
      "nullable": true
     },
     "volume_kg": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
      "readOnly": true,
      "nullable": true
     },
     "distance_km": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,4}(?:\\.\\d{0,3})?$",
      "readOnly": true,
      "nullable": true
     }
    },
    "required": [
     "distance_km",
     "id",
     "name",
     "order",
     "set_count",
     "top_set_reps",
     "top_set_weight_kg",
     "total_reps",
     "volume_kg"
    ]
   },
   "ProfilePrompt": {
    "type": "object",
    "description": "One answered question, as anybody reading the profile sees it.\n\n`question` goes out as a plain string and the readable wording comes with\nit. A client draws the label, so a question added to the server after this\nbuild shipped renders correctly on it rather than failing to decode, which\na closed enum in a response would guarantee.",
    "properties": {
     "question": {
      "type": "string",
      "readOnly": true
     },
     "question_label": {
      "type": "string",
      "readOnly": true
     },
     "answer": {
      "type": "string",
      "readOnly": true
     }
    },
    "required": [
     "answer",
     "question",
     "question_label"
    ]
   },
   "ProfileSocialLink": {
    "type": "object",
    "description": "One outbound account, as everybody else sees it.\n\nTwo fields only. The handle is the app own bookkeeping and the position is\nhow the list was ordered, neither of which anybody reading a profile has\nany use for -- and the fewer fields leave here, the less there is to keep\nconsistent between this and the public serialiser.",
    "properties": {
     "platform": {
      "$ref": "#/components/schemas/PlatformEnum"
     },
     "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 300
     }
    },
    "required": [
     "platform",
     "url"
    ]
   },
   "PublicRepbaseUser": {
    "type": "object",
    "properties": {
     "community_label": {
      "type": "string",
      "readOnly": true,
      "default": ""
     },
     "community_badge": {
      "type": "string",
      "readOnly": true,
      "default": ""
     },
     "community_color": {
      "type": "string",
      "readOnly": true,
      "default": "#F65A18"
     },
     "id": {
      "type": "integer",
      "readOnly": true
     },
     "username": {
      "type": "string",
      "readOnly": true
     },
     "first_name": {
      "type": "string",
      "readOnly": true
     },
     "last_name": {
      "type": "string",
      "readOnly": true
     },
     "bio": {
      "type": "string",
      "maxLength": 300
     },
     "profile_photo_url": {
      "type": "string",
      "nullable": true,
      "readOnly": true
     },
     "disciplines": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "readOnly": true
     },
     "prompts": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ProfilePrompt"
      },
      "readOnly": true
     },
     "social_links": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ProfileSocialLink"
      },
      "readOnly": true
     },
     "gym": {
      "type": "integer",
      "nullable": true
     },
     "gym_name": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "gym_city": {
      "type": "string",
      "readOnly": true,
      "nullable": true
     },
     "height_cm": {
      "type": "integer",
      "nullable": true,
      "readOnly": true
     },
     "weight_kg": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
      "nullable": true,
      "readOnly": true
     },
     "target_weight_kg": {
      "type": "string",
      "format": "decimal",
      "pattern": "^-?\\d{0,4}(?:\\.\\d{0,2})?$",
      "nullable": true,
      "readOnly": true
     },
     "shows_height": {
      "type": "boolean"
     },
     "shows_weight": {
      "type": "boolean"
     },
     "shows_target_weight": {
      "type": "boolean"
     },
     "is_profile_public": {
      "type": "boolean"
     },
