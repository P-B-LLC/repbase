[Unit]
Description=Rytivo For You learned ranking model training
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=django
Group=django
WorkingDirectory=/home/django/app
EnvironmentFile=/etc/repbase.env
ExecStart=/home/django/app/.venv/bin/python manage.py train_ranking_model
TimeoutStartSec=1800
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
StandardOutput=journal
StandardError=journal
